  - DOMAIN-SUFFIX,volces.com,REJECT
  - DOMAIN-SUFFIX,gdt.qq.com,REJECT
  - DOMAIN-SUFFIX,ugdtimg.com,REJECT
  - DOMAIN,sdk.e.qq.com,REJECT
  - DOMAIN,sdkquic.e.qq.com,REJECT
  - DOMAIN,tdid.m.qq.com,REJECT
  - DOMAIN-SUFFIX,sigmob.cn,REJECT
  - DOMAIN-SUFFIX,mobads.baidu.com,REJECT
  - DOMAIN-SUFFIX,mobads-logs.baidu.com,REJECT
  - DOMAIN,mobads-pre-config.cdn.bcebos.com,REJECT
  - DOMAIN,bgg.baidu.com,REJECT
  - DOMAIN,wn.pos.baidu.com,REJECT
  - DOMAIN,open.e.kuaishou.com,REJECT
  - DOMAIN-SUFFIX,kuaishouzt.com,REJECT
  - DOMAIN-SUFFIX,adkwai.com,REJECT
  - DOMAIN,gdfp.gifshow.com,REJECT
  - DOMAIN-SUFFIX,umeng.com,REJECT
  - DOMAIN-SUFFIX,beizi.biz,REJECT
  - DOMAIN-SUFFIX,tuia.cn,REJECT
  - DOMAIN-SUFFIX,1rtb.net,REJECT
  - DOMAIN-SUFFIX,1rtb.com,REJECT
  - DOMAIN-SUFFIX,adintl.cn,REJECT
  - DOMAIN-SUFFIX,zhangyuyidong.cn,REJECT
  - DOMAIN-SUFFIX,hubcloud.com.cn,REJECT
  - DOMAIN-SUFFIX,medproad.com,REJECT
  - DOMAIN-SUFFIX,xlqeai.com,REJECT
  - DOMAIN-SUFFIX,ndcjl.com,REJECT
  - DOMAIN-SUFFIX,magicacid.cn,REJECT
  - DOMAIN-SUFFIX,app-ads-services.com,REJECT
  - DOMAIN-SUFFIX,app-analytics-services.com,REJECT
  - DOMAIN,impdsp.meituan.com,REJECT
  - DOMAIN,clickdsp.meituan.com,REJECT
  - DOMAIN,afd.baidu.com,REJECT
  - DOMAIN,afdconf.baidu.com,REJECT
  - DOMAIN,nadvideo2.baidu.com,REJECT
  - DOMAIN,als.baidu.com,REJECT
  - DOMAIN,mobads.baidu.com,REJECT
  - DOMAIN,mobads-logs.baidu.com,REJECT
  - DOMAIN-SUFFIX,adscdn.baidu.com,REJECT
  - DOMAIN-SUFFIX,cpro.baidu.com,REJECT
  - DOMAIN-SUFFIX,pos.baidu.com,REJECT
  - DOMAIN,map-mobile-opnimg.cdn.bcebos.com,REJECT
  - DOMAIN-SUFFIX,optimus-ads.amap.com,REJECT
  - DOMAIN,optimus-ads.amap.com.w.alikunlun.com,REJECT
  - DOMAIN-SUFFIX,adiu.amap.com,REJECT
  - DOMAIN-SUFFIX,logs.amap.com,REJECT
  - DOMAIN-SUFFIX,dualstack-logs.amap.com,REJECT
  - DOMAIN,free-aos-cdn-image.amap.com,REJECT
  - DOMAIN,www.qchannel01.cn,REJECT
  - DOMAIN,i.qchannel03.cn,REJECT
  - DOMAIN-SUFFIX,advlion.com,REJECT
  - DOMAIN,integralwall.baidu.com,REJECT

http:
  rewrite:
    - ^https?:\/\/dss0\.bdstatic\.com\/.+/tam-ogel\/.+\.(jpg|mp4) - reject
    - ^https?:\/\/dss0\.bdstatic\.com\/-0U0bnSm1A5BphGlnYG\/ - reject
    - ^https?:\/\/(?:ecom\.map\.baidu\.com|(?:\d+\.){3}\d+)\/ad-ops\/ - reject
    - ^https?:\/\/(?:[\w.-]+\.amap\.com|(?:\d+\.){3}\d+)\/ws\/asa\/ads_attribution - reject
    - ^https?:\/\/(?:[\w.-]+\.amap\.com|(?:\d+\.){3}\d+)\/uploadimg\/\w+\.gif - reject
  script:
    - match: ^https?:\/\/(?:newclient\.map\.baidu\.com|(?:\d+\.){3}\d+)\/client\/crossmarketing
      name: baidumap_js
      type: response
      require-body: true
      binary: true
      timeout: 30
    - match: ^https?:\/\/(?:newclient\.map\.baidu\.com|(?:\d+\.){3}\d+)\/client\/phpui2\/\?qt=ads
      name: baidumap_js_2
      type: response
      require-body: true
      binary: true
      timeout: 30
    - match: ^https?:\/\/(?:[\w.-]+\.amap\.com|(?:\d+\.){3}\d+)\/ws\/(?:aos|valueadded)\/alimama\/splash_screen(?:_rt)?
      name: amap_js
      type: response
      require-body: true
      binary: true
      timeout: 30
    - match: ^https?:\/\/(?:[\w.-]+\.amap\.com|(?:\d+\.){3}\d+)\/ws\/(?:faas\/amap-navigation\/main-page|shield\/frogserver\/aocs|message\/notice\/list)
      name: amap_js
      type: response
      require-body: true
      timeout: 30
    - match: ^https?:\/\/(?:[\w.-]+\.amap\.com|(?:\d+\.){3}\d+)\/ws\/(?:shield\/(?:dsp\/profile\/index\/nodefaas|search\/(?:new_hotword|nearbyrec_smart))|promotion-web\/resource|msgbox\/pull)
      name: amap_js
      type: response
      require-body: true
      timeout: 30

  mitm:
    - "newclient.map.baidu.com"
    - "ecom.map.baidu.com"
    - "afd.baidu.com"
    - "dss0.bdstatic.com"
    - "m5.amap.com"
    - "m5-x.amap.com"
    - "m5-zb.amap.com"
    - "m5*.amap.com"
    - "sns.amap.com"
    - "center.amap.com"
    - "amap-aos-info-nogw.amap.com"
    - "optimus-ads.amap.com"

script-providers:
  baidumap_js:
    url: https://raw.githubusercontent.com/aict666/rule_hub/master/rewrite/Surge/Advertising/baidumap.js
    interval: 86400
  baidumap_js_2:
    url: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/baidumap.js
    interval: 86400
  amap_js:
    url: https://raw.githubusercontent.com/aict666/rule_hub/master/rewrite/Surge/Advertising/amap.js
    interval: 86400
